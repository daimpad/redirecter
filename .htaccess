Options -Indexes

# Plesk legt ein index.html („Hier entsteht eine neue Webseite") in httpdocs.
# Ohne diese Zeile gewinnt es gegen index.php und die App bleibt unsichtbar.
DirectoryIndex index.php

RewriteEngine On

# HTTP → HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Plesk zieht das ganze Repository in den Web-Root. Was nur ins Repository
# gehört, soll nicht über HTTP abrufbar sein.
RewriteRule ^(README\.md|\.gitignore|\.github/|docs/) - [R=404,L]

# Statische Dateien und Verzeichnisse direkt durchlassen
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Alle anderen Anfragen als Slug an redirect.php weiterleiten
RewriteRule ^([A-Za-z0-9_-]+)/?$ redirect.php?s=$1 [L,QSA]

# Interne Hilfsdateien vor direktem HTTP-Zugriff schützen.
# config.local.php trägt den Passwort-Hash und muss mit abgedeckt sein.
<FilesMatch "^(config(\.local)?(\.example)?|functions)\.php$">
    Require all denied
</FilesMatch>

# Selbst gehostete Schriften (nozilla CI — kein Dritt-CDN)
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2      "access plus 1 year"
    ExpiresByType image/svg+xml   "access plus 1 month"
    ExpiresByType image/png       "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 week"
</IfModule>
